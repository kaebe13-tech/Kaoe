{
  "name": "kaoe-god-sandbox",
  "private": true,
  "version": "0.1.0",
  "description": "Kaoe — a browser-based 3D god sandbox. Several small civilizations live, explore, build and pray on one continent, each on its own clock, while you watch as their god.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "soak": "tsx scripts/soak.ts",
    "e2e": "node e2e/run.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
