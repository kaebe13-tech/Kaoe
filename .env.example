# Copy this file to .env and fill in your own values. Never commit .env.
#
# Google Gemini API key for the optional AI leaders. It is read only by the server
# (the Vite dev server or `npm run serve`) and is never sent to the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated model preference list (first available wins).
# GEMINI_MODEL=gemini-2.5-flash,gemini-flash-latest

# Optional: set to off to run without any model even if a key is present.
# KAOE_AI=on

# Optional: production server address.
# PORT=8787
# HOST=127.0.0.1
